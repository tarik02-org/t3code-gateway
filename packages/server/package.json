{
  "name": "@t3code-gateway/server",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --banner:js=\"import { createRequire as __t3CreateRequire } from 'node:module'; const require = __t3CreateRequire(import.meta.url);\" --outfile=dist/src/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@t3code-gateway/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "catalog:",
    "fflate": "^0.8.3",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.28.2",
    "vite-plus": "catalog:"
  }
}
