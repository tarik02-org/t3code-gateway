{
  "name": "t3code-gateway",
  "version": "0.6.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "build": "vp run -r build",
    "download:t3code-web": "node packages/server/src/bin/download-t3code-web-dist.ts",
    "package:runtime": "sh packaging/runtime/prepare.sh",
    "screenshots": "pnpm --filter @t3code-gateway/screenshots capture",
    "screenshots:install": "pnpm --filter @t3code-gateway/screenshots install:chromium",
    "changeset": "changeset",
    "changeset:version": "changeset version && node packaging/scripts/sync-root-version.mjs",
    "typecheck": "vp run -r typecheck",
    "tc": "vp run -r typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist .vite-plus packages/*/.vite-plus *.tsbuildinfo packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "4.0.0-beta.93",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@10.24.0",
  "packageExtensions": {
    "vite-plus@*": {
      "dependencies": {
        "vite": "catalog:"
      }
    }
  },
  "peerDependencyRules": {
    "allowAny": [
      "vite"
    ],
    "allowedVersions": {
      "vite": "*"
    }
  }
}
